DATABASE_URL=postgres://biyoai:biyoai@localhost:5432/biyoai
# Optional: only needed when running the test suite. Must point at a
# disposable database whose name contains "test" (see tests/lib/retrieve.test.ts,
# which refuses to run its destructive DELETEs otherwise). Defaults to
# DATABASE_URL if unset.
TEST_DATABASE_URL=
GROQ_API_KEY=
# Chat model. Must exist on your Groq account: list them with
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Optional: low, medium or high. Only for reasoning models such as gpt-oss;
# "low" is faster and enough for answering from provided sources.
GROQ_REASONING_EFFORT=low

# Embeddings (turn text into vectors for search) run locally in the ollama
# service of docker-compose.yml; the app container is configured there.
# These two are for scripts you run on the host (npm run eval, npm run dev):
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text
# The database column is 768 wide, so the model must output 768 dimensions.
# EMBED_API_KEY=

# Required, at least 32 characters. The app refuses to start signing/checking
# sessions without a real value here.
# generate with: openssl rand -hex 32
SESSION_SECRET=
